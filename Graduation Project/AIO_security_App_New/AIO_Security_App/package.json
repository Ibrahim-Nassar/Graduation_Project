{
  "name": "aio-security-app",
  "productName": "AIO Security APP",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop app to check IOCs against multiple threat intel providers.",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "start": "concurrently --kill-others -n VITE,ELECTRON -c cyan,magenta \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "vite build && cross-env NODE_ENV=production electron-builder",
    "package": "electron-builder",
    "lint": "eslint . --ext .ts,.tsx,.cjs,.js",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --reporter=default --coverage",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "test:all": "npm run lint && npm run typecheck && npm run test && npm run e2e"
  },
  "build": {
    "appId": "com.example.aiosecurityapp",
    "productName": "AIO Security APP",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false
    }
  },
  "dependencies": {
    "axios": "^1.7.7",
    "electron-store": "^8.2.0",
    "form-data": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "tesseract.js": "^5.1.0"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.26.5",
    "@playwright/test": "^1.48.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.8",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "^2.1.9",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^31.4.0",
    "electron-builder": "^25.0.5",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-unicorn": "^55.0.0",
    "jsdom": "^25.0.1",
    "msw": "^2.6.8",
    "prettier": "^3.3.3",
    "typescript": "5.5.4",
    "vite": "^5.4.8",
    "vitest": "^2.1.1",
    "wait-on": "^8.0.0"
  }
}
